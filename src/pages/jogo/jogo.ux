<template>
  <div class="page">
    <div class="view">
      <div class="cabecalho">
        <text class="situacao">{{ situacao }}</text>
        <text class="hora">{{ hora }}</text>
      </div>
      <div class="linha linha-eu" onclick="pontoEu">
        <div class="nome-col">
          <div show="{{ !simples }}" class="bola {{ saqueEu ? 'bola-on' : '' }}"></div>
          <text class="nome">EU</text>
          <div class="lados" show="{{ !simples }}">
            <div class="traco {{ ladoEsq ? 'traco-on' : '' }}"></div>
            <div class="traco {{ ladoDir ? 'traco-on' : '' }}"></div>
          </div>
        </div>
        <text class="games {{ gamesLongos ? 'games-longos' : '' }}">{{ gamesEu }}</text>
        <text class="pontos {{ pontosEu === 'AD' ? 'pontos-ad' : '' }}">{{ pontosEu }}</text>
      </div>
      <div class="linha linha-adv" onclick="pontoAdv">
        <div class="nome-col">
          <div show="{{ !simples }}" class="bola {{ saqueAdv ? 'bola-on' : '' }}"></div>
          <text class="nome">ADV</text>
          <div class="lados" show="{{ !simples }}">
            <div class="traco {{ ladoEsq ? 'traco-on' : '' }}"></div>
            <div class="traco {{ ladoDir ? 'traco-on' : '' }}"></div>
          </div>
        </div>
        <text class="games {{ gamesLongos ? 'games-longos' : '' }}">{{ gamesAdv }}</text>
        <text class="pontos {{ pontosAdv === 'AD' ? 'pontos-ad' : '' }}">{{ pontosAdv }}</text>
      </div>
      <div class="rodape">
        <text class="botao" onclick="desfazer">DESFAZER</text>
        <text class="botao {{ confirmandoNovo ? 'botao-alerta' : '' }}" onclick="novo">{{ textoNovo }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'
import { novoJogo, ponto, textoPontos, linhaGames, rotuloSituacao, ladoSaque } from '../../common/placar'
import { carregar, salvar, apagar } from '../../common/salvo'

var LIMITE_HISTORICO = 100
var estado = null
var historico = []
var timerNovo = null
var timerHora = null

function pararRelogio() {
  if (timerHora !== null) clearTimeout(timerHora)
  timerHora = null
}

function iniciarRelogio(pagina) {
  pararRelogio()
  function atualizar() {
    var agora = new Date()
    var horas = agora.getHours()
    var minutos = agora.getMinutes()
    pagina.hora = (horas < 10 ? '0' : '') + horas + ':' + (minutos < 10 ? '0' : '') + minutos
    var espera = (60 - agora.getSeconds()) * 1000 - agora.getMilliseconds() + 50
    timerHora = setTimeout(atualizar, espera)
  }
  atualizar()
}

function vibrar(modo) {
  try { vibrator.vibrate({ mode: modo }) } catch (e) {}
}

export default {
  protected: {
    modo: 'novo',
    tipo: 'tenis',
    meta: '5',
    sets: '3',
    vantagem: '1',
    sacador: '0'
  },
  private: {
    situacao: '',
    simples: false,
    saqueEu: false,
    saqueAdv: false,
    gamesEu: '',
    gamesAdv: '',
    gamesLongos: false,
    ladoEsq: false,
    ladoDir: false,
    pontosEu: '0',
    pontosAdv: '0',
    hora: '--:--',
    confirmandoNovo: false,
    textoNovo: 'NOVO'
  },
  onInit() {
    var pagina = this
    estado = null
    historico = []
    if (this.modo === 'continuar') {
      carregar(function (dados) {
        if (dados) {
          estado = dados.estado
          historico = dados.historico || []
        } else {
          estado = pagina.criarJogo()
        }
        pagina.mostrar()
      })
    } else {
      estado = this.criarJogo()
      salvar(estado, historico)
      this.mostrar()
    }
  },
  onShow() {
    iniciarRelogio(this)
    // Mantém a tela acesa durante a partida, se o firmware permitir.
    try { brightness.setKeepScreenOn({ keepScreenOn: true }) } catch (e) {}
  },
  onHide() {
    pararRelogio()
    try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) {}
  },
  onDestroy() {
    try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) {}
    pararRelogio()
    if (timerNovo !== null) clearTimeout(timerNovo)
    timerNovo = null
  },
  criarJogo() {
    return novoJogo({
      tipo: this.tipo,
      meta: this.meta,
      sets: parseInt(this.sets, 10) || 3,
      vantagem: this.vantagem !== '0',
      sacador: this.sacador === '1' ? 1 : 0
    })
  },
  mostrar() {
    if (!estado) return
    var p = textoPontos(estado)
    var fim = estado.vencedor !== null
    this.simples = estado.tipo === 'simples'
    this.situacao = rotuloSituacao(estado)
    this.pontosEu = fim && !this.simples ? (estado.vencedor === 0 ? 'V' : '') : p[0]
    this.pontosAdv = fim && !this.simples ? (estado.vencedor === 1 ? 'V' : '') : p[1]
    this.gamesEu = linhaGames(estado, 0).join(' ')
    this.gamesAdv = linhaGames(estado, 1).join(' ')
    // A partir de 3 sets na linha a fonte grande não cabe na faixa (~66 px).
    this.gamesLongos = linhaGames(estado, 0).length > 2
    this.saqueEu = !fim && estado.sacador === 0
    this.saqueAdv = !fim && estado.sacador === 1
    // Os dois jogadores ficam do mesmo lado (cada um olhando do seu campo), então a indicação é a mesma.
    var lado = ladoSaque(estado)
    this.ladoEsq = !fim && lado === 'esquerda'
    this.ladoDir = !fim && lado === 'direita'
  },
  marcar(jogador) {
    if (!estado || estado.vencedor !== null) return
    var antes = estado
    var depois = ponto(estado, jogador)
    historico.push(antes)
    if (historico.length > LIMITE_HISTORICO) historico.shift()
    estado = depois
    salvar(estado, historico)
    // Vibração curta a cada ponto e longa quando fecha game, set ou partida.
    var fechouGame = depois.games[0] + depois.games[1] !== antes.games[0] + antes.games[1] ||
      depois.setsFechados.length !== antes.setsFechados.length
    vibrar(fechouGame || depois.vencedor !== null ? 'long' : 'short')
    this.mostrar()
  },
  pontoEu() {
    this.marcar(0)
  },
  pontoAdv() {
    this.marcar(1)
  },
  desfazer() {
    if (historico.length === 0) return
    estado = historico.pop()
    salvar(estado, historico)
    vibrar('short')
    this.mostrar()
  },
  novo() {
    // Pede um segundo toque para não perder a partida por engano.
    if (!this.confirmandoNovo) {
      var pagina = this
      this.confirmandoNovo = true
      this.textoNovo = 'APAGAR?'
      timerNovo = setTimeout(function () {
        pagina.confirmandoNovo = false
        pagina.textoNovo = 'NOVO'
        timerNovo = null
      }, 3000)
      return
    }
    if (timerNovo !== null) clearTimeout(timerNovo)
    timerNovo = null
    apagar()
    router.back()
  }
}
</script>

<style>
.page { flex: 1; flex-direction: column; background-color: #000000; }
.view { flex: 1; width: 192px; flex-direction: column; align-items: center; padding-top: 6px; }
.cabecalho { width: 184px; height: 26px; flex-direction: row; align-items: center; }
.situacao { width: 138px; height: 26px; lines: 1; font-size: 16px; font-weight: bold; color: #c8f04a; text-align: left; }
.hora { width: 46px; height: 26px; lines: 1; font-size: 13px; color: #aeb7c2; text-align: right; }
.linha { width: 184px; height: 88px; margin-top: 4px; border-radius: 16px; flex-direction: row; align-items: center; padding-left: 8px; padding-right: 8px; }
.linha-eu { background-color: #12331f; }
.linha-adv { background-color: #1f2a3a; }
.nome-col { width: 48px; flex-direction: column; align-items: center; }
.bola { width: 12px; height: 12px; margin-top: 2px; margin-bottom: 2px; border-radius: 6px; background-color: #000000; }
.bola-on { background-color: #c8f04a; }
.nome { height: 26px; font-size: 18px; font-weight: bold; color: #ffffff; text-align: center; }
.games { flex: 1; lines: 1; font-size: 22px; font-weight: bold; color: #ffd60a; text-align: center; }
.lados { width: 40px; height: 10px; margin-top: 4px; flex-direction: row; justify-content: space-between; }
.traco { width: 17px; height: 5px; border-radius: 2px; background-color: #3a4a42; }
.traco-on { background-color: #ffd60a; }
.games-longos { font-size: 16px; font-weight: normal; }
.pontos { width: 54px; lines: 1; font-size: 38px; font-weight: bold; color: #ffffff; text-align: right; }
.pontos-ad { font-size: 26px; }
.rodape { width: 184px; height: 42px; margin-top: 6px; flex-direction: row; justify-content: space-between; }
.botao { width: 90px; height: 42px; font-size: 14px; font-weight: bold; color: #ffffff; text-align: center; background-color: #2a2a2a; border-radius: 22px; }
.botao-alerta { background-color: #a33a2a; }
</style>
