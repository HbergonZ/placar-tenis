<template>
  <div class="page">
    <text class="titulo">PLACAR TÊNIS</text>
    <text class="opcao" onclick="trocarSets">{{ textoSets }}</text>
    <text class="opcao" onclick="trocarVantagem">{{ textoVantagem }}</text>
    <text class="opcao" onclick="trocarSacador">{{ textoSacador }}</text>
    <text class="botao" onclick="comecar">COMEÇAR</text>
    <text class="continuar" show="{{ temSalvo }}" onclick="continuar">CONTINUAR PARTIDA</text>
  </div>
</template>

<script>
import router from '@system.router'
import { carregar } from '../../common/salvo'

var OPCOES_SETS = [1, 3, 5]

export default {
  private: {
    sets: 3,
    vantagem: true,
    sacador: 0,
    temSalvo: false,
    textoSets: '',
    textoVantagem: '',
    textoSacador: ''
  },
  onInit() {
    this.atualizar()
  },
  onShow() {
    var pagina = this
    carregar(function (dados) {
      pagina.temSalvo = !!(dados && dados.estado.vencedor === null)
    })
  },
  atualizar() {
    this.textoSets = this.sets === 1 ? 'Set único' : 'Melhor de ' + this.sets
    this.textoVantagem = this.vantagem ? 'Com vantagem' : 'Sem vantagem'
    this.textoSacador = this.sacador === 0 ? 'Saque: EU' : 'Saque: ADV'
  },
  trocarSets() {
    var i = OPCOES_SETS.indexOf(this.sets)
    this.sets = OPCOES_SETS[(i + 1) % OPCOES_SETS.length]
    this.atualizar()
  },
  trocarVantagem() {
    this.vantagem = !this.vantagem
    this.atualizar()
  },
  trocarSacador() {
    this.sacador = 1 - this.sacador
    this.atualizar()
  },
  comecar() {
    router.push({
      uri: '/pages/jogo',
      params: { modo: 'novo', sets: String(this.sets), vantagem: this.vantagem ? '1' : '0', sacador: String(this.sacador) }
    })
  },
  continuar() {
    router.push({ uri: '/pages/jogo', params: { modo: 'continuar' } })
  }
}
</script>

<style>
.page { flex-direction: column; align-items: center; background-color: #000000; padding-top: 18px; }
.titulo { height: 30px; font-size: 18px; font-weight: bold; color: #c8f04a; text-align: center; }
.opcao { width: 168px; height: 38px; margin-top: 6px; font-size: 16px; color: #ffffff; text-align: center; background-color: #1c2620; border-radius: 19px; }
.botao { width: 168px; height: 44px; margin-top: 10px; font-size: 18px; font-weight: bold; color: #000000; text-align: center; background-color: #c8f04a; border-radius: 22px; }
.continuar { width: 168px; height: 34px; margin-top: 8px; font-size: 13px; color: #c8f04a; text-align: center; }
</style>
